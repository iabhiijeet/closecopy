# Server
PORT=8080
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Database (Neon Postgres). Use the unpooled/direct host: the Neon pooler
# enforces an empty search_path, which breaks unqualified queries.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
OPENAI_API_KEY=

# Pinecone (PINECONE_API_KEY is preferred; PIPECONE_API_KEY is a legacy alias)
PINECONE_API_KEY=
PINECONE_INDEX=closecopy
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# PIPECONE_API_KEY=

# Mem0 (optional; memory endpoints return empty data when unset)
MEM0_API_KEY=
# MEM0_HOST=
# MEM0_APP_ID=
# MEM0_USER_ID_PREFIX=

# Cloudinary (uploads are signed with the API secret; no upload preset needed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Source imports
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
# TAVILY_API_BASE_URL=

# Inngest (cloud mode by default; background jobs need these keys)
# Get them at https://app.inngest.com -> Manage -> Event Keys / Signing Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local dev server instead of cloud: set INNGEST_DEV=1 and run
# `npm run dev:jobs` (needs an unblocked Inngest CLI or the Docker image).
# INNGEST_DEV=1
# INNGEST_BASE_URL=http://127.0.0.1:8288
